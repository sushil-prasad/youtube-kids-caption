# Copy to .env. Do not commit secrets.
# Device: Apple Silicon uses MPS when supported, otherwise CPU. Never require CUDA.

ASR_MODEL=pasketti_first
DEVICE=auto

# Safety (children's content defaults)
# SAFETY_MODE: strict | standard | review-only
SAFETY_MODE=strict
# UNKNOWN_PROFANITY: censor | flag | keep
UNKNOWN_PROFANITY=censor
# Extra creator allowlist entries, comma-separated
# ALLOWLIST=bass,class,Scunthorpe,assistant
CORRECTION_THRESHOLD=0.65
CONTEXT_WINDOW=5
# Optional overrides (defaults live in app/safety/)
# PROFANITY_WORDS_PATH=app/safety/profanity_words.txt
# PROFANITY_PHRASES_PATH=app/safety/profanity_phrases.txt
# ALLOWLIST_PATH=app/safety/allowlist.txt
# CORRECTIONS_PATH=app/safety/corrections.json
# VOCABULARY_PATH=

ENABLE_SOUND_EVENTS=0
ENABLE_SPEAKER_LABELS=1
ENABLE_DIARIZATION=0
ENABLE_AUDIO_NORMALIZATION=0

# Local merged 1st-place checkpoint directory, if you have one.
# Otherwise Qwen/Qwen3-ASR-1.7B is used.
# ASR_MODEL_PATH=models/pasketti_first

LANGUAGE=English
FORCED_ALIGNER=Qwen/Qwen3-ForcedAligner-0.6B
ENABLE_FORCED_ALIGNER=1
MAX_NEW_TOKENS=512
MAX_INFERENCE_BATCH_SIZE=1

# Confidence bands (README §9)
CONFIDENCE_HIGH=0.90
CONFIDENCE_MEDIUM=0.70
CONFIDENCE_UNKNOWN=0.50

# Caption segmentation (README §19–21)
MAX_CHARS_PER_LINE=42
MAX_CAPTION_LINES=2
MIN_CUE_DURATION=0.50
MAX_CUE_DURATION=7.0
PAUSE_GAP=0.60
PUNCTUATION_PAUSE=0.45
MAX_CPS=17.0
MAX_WPS=4.0
MIN_CAPTION_GAP=0.08

# Sound events: only insert when confidence exceeds this
SOUND_EVENT_THRESHOLD=0.80
